# Allow non-root access to HWCX / AK4 USB Digital Display (0145:1002)
# Copy to /etc/udev/rules.d/99-ak4-display.rules and run:
#   sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="usb", ATTR{idVendor}=="0145", ATTR{idProduct}=="1002", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0145", ATTRS{idProduct}=="1002", MODE="0666", TAG+="uaccess"

